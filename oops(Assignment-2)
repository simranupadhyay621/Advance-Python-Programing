count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["connected to database\n","login into mobile\n","mobile security\n"]}]},{"cell_type":"code","source":["#Abstract Class for Shapes\n","\n","from abc import ABC, abstractmethod\n","\n","class Shape(ABC):\n","    @abstractmethod\n","    def area(self):\n","        pass\n","\n","class Circle(Shape):\n","    def __init__(self, radius):\n","        self.radius = radius\n","\n","    def area(self):\n","        return 3.14 * self.radius * self.radius\n","\n","circle = Circle(5)\n","print(circle.area())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bbTRY_N5QNQl","executionInfo":{"status":"ok","timestamp":1776443004179,"user_tz":-330,"elapsed":48,"user":{"displayName":"Simran Upadhyay","userId":"15614553199493926723"}},"outputId":"3fc20a9e-1dc4-4f8a-8747-250a3bd7b9aa"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["78.5\n"]}]},{"cell_type":"code","source":["from abc import ABC, abstractmethod\n","\n","# Abstract class\n","class Animal(ABC):\n","    @abstractmethod\n","    def make_sound(self):\n","        pass\n","\n","# Subclass inheriting from the abstract class\n","class Dog(Animal):\n","    def make_sound(self):\n","        print(\"Bark\")\n","\n","class Cat(Animal):\n","    def make_sound(self):\n","        print(\"Meow\")\n","\n","# Creating instances of subclasses\n","dog = Dog()\n","dog.make_sound()\n","\n","cat = Cat()\n","cat.make_sound()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Wk3i7OJmQROC","executionInfo":{"status":"ok","timestamp":1776443076875,"user_tz":-330,"elapsed":19,"user":{"displayName":"Simran Upadhyay","userId":"15614553199493926723"}},"outputId":"c297e5b0-8acb-4d3f-cc1c-31e6e561844d"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Bark\n","Meow\n"]}]},{"cell_type":"markdown","source":["Polymorphism:"],"metadata":{"id":"5zOrAfMURM9W"}},{"cell_type":"code","source":["#1. Polymorphism with Methods\n","#Different classes can have methods with the same name, but they behave differently.\n","\n","class Cat:\n","    def sound(self):\n","      return \"Meow\"\n","\n","class Dog:\n","    def sound(self):\n","      return \"Woof\"\n","\n","# Using Polymorphism\n","animals = [Cat(), Dog()]\n","for animal in animals:\n","    print(animal.sound())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7eKYOoZsQi9T","executionInfo":{"status":"ok","timestamp":1776443137791,"user_tz":-330,"elapsed":9,"user":{"displayName":"Simran Upadhyay","userId":"15614553199493926723"}},"outputId":"79c5a0cf-0fe0-4099-ca7a-9a3075ffe429"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Meow\n","Woof\n"]}]},{"cell_type":"code","source":["#2. Polymorphism with Inheritance\n","#A parent class method is overridden by child classes.\n","\n","\n","class Vehicle:\n","  def move(self):\n","    return \"Moving\"\n","class Car(Vehicle):\n","    def move(self):\n","      return \"Car is driving\"\n","\n","class Boat(Vehicle):\n","    def move(self):\n","      return \"Boat is sailing\"\n","\n","# Using Polymorphism\n","vehicles = [Car(), Boat()]\n","for v in vehicles:\n","    print(v.move())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gSF5P8hxQx04","executionInfo":{"status":"ok","timestamp":1776443361616,"user_tz":-330,"elapsed":56,"user":{"displayName":"Simran Upadhyay","userId":"15614553199493926723"}},"outputId":"d11f51a8-2719-4e90-d340-62b15431c4c5"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Car is driving\n","Boat is sailing\n"]}]},{"cell_type":"code","source":["class Rectangle:\n","    def area(self, w, h): return w * h\n","\n","class Circle:\n","    def area(self, r): return 3.14 * r * r\n","\n","# Using Polymorphism\n","shapes = [Rectangle(), Circle()]\n","print(shapes[0].area(5, 10))  # Rectangle\n","print(shapes[1].area(7))      # Circle\n"],"metadata":{"colab"